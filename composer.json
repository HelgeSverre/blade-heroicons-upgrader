{
    "name": "helgesverre/blade-heroicons-upgrader",
    "description": "Automatically upgrade Heroicons v1 to v2 icon names in Blade templates",
    "keywords": [
        "helgesverre",
        "laravel",
        "blade-icons",
        "heroicons",
        "blade-heroicons-upgrader"
    ],
    "homepage": "https://github.com/helgesverre/blade-heroicons-upgrader",
    "license": "MIT",
    "authors": [
        {
            "name": "Helge Sverre",
            "email": "helge.sverre@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "laravel/prompts": "^0.1.14|^0.2|^0.3",
        "spatie/laravel-package-tools": "^1.14.0",
        "spatie/regex": "^3.1.1"
    },
    "require-dev": {
        "larastan/larastan": "^2.0.1",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^7.8|^8.0",
        "orchestra/testbench": "^8.8|^9.0|^10.0",
        "pestphp/pest": "^2.30|^3.0|^4.0",
        "pestphp/pest-plugin-arch": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0|^4.0",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^1.0",
        "phpstan/phpstan-phpunit": "^1.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "HelgeSverre\\BladeHeroiconsUpgrader\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HelgeSverre\\BladeHeroiconsUpgrader\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@composer run prepare",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@composer run build",
            "@php vendor/bin/testbench serve"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "herd coverage vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "test-install": "bash test-install.sh",
        "e2e": [
            "@composer install",
            "@composer format",
            "@composer analyse",
            "@composer test",
            "@composer test-coverage",
            "bash test-install.sh",
            "rm -rf wip/"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HelgeSverre\\BladeHeroiconsUpgrader\\BladeHeroiconsUpgraderServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
